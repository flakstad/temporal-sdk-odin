;; Durable Worker replacement and Workflow replay, entirely from Kvist.
(package main)

(import fmt "core:fmt")
(import os "core:os")
(import time "core:time")
(import temporal "../../temporal")
(import activity "../../temporal/activity")
(import client "../../temporal/client")
(import worker "../../temporal/worker")
(import workflow "../../temporal/workflow")

(def Task-Queue "kvist-sdk-replay")
(def Workflow-Type "kvist_sdk_replay_workflow")
(def Activity-Type "kvist_replay_greeting")
(def Expected-Result "Hello Temporal after durable replay")

(defn print-client-error [operation: string, err: ^client.Error] -> int
  (fmt.eprintf "%s failed (kind=%v status=%d): %s\n"
               operation
               err^.kind
               err^.status_code
               (string err^.message))
  (client.error_free err)
  1)

(defn print-worker-error [operation: string, err: ^temporal.Worker_Error] -> int
  (fmt.eprintf "%s failed: %s\n" operation (string err^.message))
  (temporal.worker_error_free err)
  1)

(defn close-worker [sdk-worker: ^temporal.Worker]
  (let [err (temporal.worker_close sdk-worker)]
    (when (!= err.message nil)
      (discard (print-worker-error "close Worker" (addr err))))))

(defn greeting-activity [ctx: ^activity.Context, name: string] -> string
  (let [info (activity.info ctx)]
    (fmt.printf "activity type=%s attempt=%d input=%q\n"
                info.activity_type
                info.attempt
                name)
    (discard (os.flush os.stdout))
    (if (= name "Temporal")
      Expected-Result
      "Hello after durable replay")))

(defn replay-workflow [ctx: ^workflow.Fiber_Context, name: string] -> string
  ;; The Activity result remains on this Workflow's fiber stack while the
  ;; durable timer is pending. A replacement Worker reconstructs this point
  ;; from Temporal history on a fresh stack.
  (let [greeting (workflow.execute_activity ctx Activity-Type name)]
    (workflow.sleep ctx (* 5 time.Second))
    greeting))

(defn observe-activation [result: ^workflow.Process_Result]
  ;; This observer runs outside Workflow code, so diagnostic I/O is safe. It
  ;; makes the fresh-process replay visible to the acceptance test.
  (fmt.printf
    "activation replay=%v scheduled_activity=%v resolved_activity=%d started_timer=%v waiting_timer=%d completed=%v history=%d\n"
    result^.is_replaying
    result^.scheduled_activity
    result^.resolved_activity_seq
    result^.started_timer
    result^.waiting_timer_seq
    result^.completed
    result^.history_length)
  (discard (os.flush os.stdout)))

(defn register-handlers [sdk-worker: ^temporal.Worker] -> int
  (let [activity-error
        (temporal.worker_register_activity
          sdk-worker
          Activity-Type
          greeting-activity)]
    (when (!= activity-error.message nil)
      (return (print-worker-error "register Activity" (addr activity-error)))))

  (let [workflow-error
        (temporal.worker_register_workflow
          sdk-worker
          Workflow-Type
          replay-workflow)]
    (when (!= workflow-error.message nil)
      (return (print-worker-error "register Workflow" (addr workflow-error)))))

  0)

(defn run-created-worker [sdk-worker: ^temporal.Worker,
                          max-workflows: int] -> int
  (let [registration-status (register-handlers sdk-worker)]
    (when (!= registration-status 0)
      (return registration-status)))

  (fmt.printf "worker ready task_queue=%s\n" Task-Queue)
  (discard (os.flush os.stdout))

  (let [[stats run-error]
        (temporal.worker_run
          sdk-worker
          (worker.Run_Options
            :max_workflow_executions max-workflows
            :on_workflow_activation observe-activation))]
    (when (!= run-error.message nil)
      (return (print-worker-error "run Worker" (addr run-error))))

    (fmt.printf "worker stopped workflows=%d activities=%d activations=%d replay_activations=%d\n"
                stats.workflow_executions_completed
                stats.activity_tasks_completed
                stats.workflow_activations_completed
                stats.workflow_replay_activations)
    0))

(defn create-worker-and-run [sdk-client: ^temporal.Client,
                             max-workflows: int] -> int
  (let [[sdk-worker create-error]
        (temporal.worker_create sdk-client Task-Queue)]
    (when (!= create-error.message nil)
      (return (print-worker-error "create Worker" (addr create-error))))

    (defer (close-worker (addr sdk-worker)))
    (run-created-worker (addr sdk-worker) max-workflows)))

(defn run-worker [max-workflows: int] -> int
  (let [[sdk-client connect-error] (temporal.connect)]
    (when (!= connect-error.message nil)
      (return (print-client-error "connect" (addr connect-error))))

    (defer (temporal.client_close (addr sdk-client)))
    (create-worker-and-run (addr sdk-client) max-workflows)))

(defn start-with-client [sdk-client: ^temporal.Client,
                         workflow-id: string] -> int
  (let [[handle start-error]
        (client.start_workflow_json
          sdk-client
          Workflow-Type
          "Temporal"
          (client.Start_Workflow_Options
            :id workflow-id
            :task_queue Task-Queue
            :workflow_execution_timeout time.Minute
            :workflow_run_timeout time.Minute
            :workflow_task_timeout (* 10 time.Second)))]
    (when (!= start-error.message nil)
      (return (print-client-error "start Workflow" (addr start-error))))

    (defer (client.workflow_handle_free (addr handle)))
    (fmt.printf "started workflow_id=%s run_id=%s\n" handle.id handle.run_id)
    0))

(defn start-workflow [workflow-id: string] -> int
  (let [[sdk-client connect-error] (temporal.connect)]
    (when (!= connect-error.message nil)
      (return (print-client-error "connect" (addr connect-error))))

    (defer (temporal.client_close (addr sdk-client)))
    (start-with-client (addr sdk-client) workflow-id)))

(defn read-result [handle: ^client.Workflow_Handle] -> int
  (let [result: string ""
        result-error (client.get_result_json handle (addr result))]
    (defer (delete result))

    (when (!= result-error.message nil)
      (return (print-client-error "get Workflow result" (addr result-error))))

    (when (!= result Expected-Result)
      (fmt.eprintf "unexpected result: %q\n" result)
      (return 1))

    (fmt.printf "result workflow_id=%s value=%q\n"
                handle^.id
                result)
    0))

(defn result-with-client [sdk-client: ^temporal.Client,
                          workflow-id: string] -> int
  (let [[handle handle-error]
        (client.get_workflow_handle sdk-client workflow-id)]
    (when (!= handle-error.message nil)
      (return (print-client-error "get Workflow handle" (addr handle-error))))

    (defer (client.workflow_handle_free (addr handle)))
    (read-result (addr handle))))

(defn await-result [workflow-id: string] -> int
  (let [[sdk-client connect-error] (temporal.connect)]
    (when (!= connect-error.message nil)
      (return (print-client-error "connect" (addr connect-error))))

    (defer (temporal.client_close (addr sdk-client)))
    (result-with-client (addr sdk-client) workflow-id)))

(defn usage []
  (fmt.eprintln "usage:")
  (fmt.eprintln "  temporal-kvist-replay worker")
  (fmt.eprintln "  temporal-kvist-replay worker-once")
  (fmt.eprintln "  temporal-kvist-replay start <workflow-id>")
  (fmt.eprintln "  temporal-kvist-replay result <workflow-id>"))

(defn run [] -> int
  (when (< (count os.args) 2)
    (usage)
    (return 2))

  (let [command (get os.args 1)]
    (cond
      (= command "worker") (run-worker 0)
      (= command "worker-once") (run-worker 1)
      (and (= command "start") (= (count os.args) 3))
        (start-workflow (get os.args 2))
      (and (= command "result") (= (count os.args) 3))
        (await-result (get os.args 2))
      :else
        (do
          (usage)
          2))))

(defn main []
  (os.exit (run)))
